# Relative base: the Vite dev server proxies /api (and /uploads) to the HTTPS
# backend, so the app stays first-party. For a non-proxied setup use the full
# URL instead, e.g. https://localhost:5000/api
VITE_API_URL=/api

# Google OAuth (same Client ID used on backend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
